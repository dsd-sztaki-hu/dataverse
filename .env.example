# Copy to .env and fill in the values before running: docker compose up
# See README.hunverse.md
#   cp .env.example .env
#
# If this repo already has a .env for mvn -Pct docker:run, merge these
# variables into it instead of overwriting.


# Required for CEDAR proxy and importing metadata blocks (read-only). Create an API key
# in your CEDAR profile at https://cedar.schema.researchdata.hu
# Paste the hex key only. Do not include an "apiKey " prefix.
# ARP_CEDAR_PROXY_API_KEY=


# Builtin superuser (dataverseAdmin) password. The demo bootstrap persona
# hardcodes admin1; this var is unused unless you bind-mount a custom init.sh.
# DATAVERSE_ADMIN_PASSWORD=admin1


# Postgres credentials used by both postgres and dataverse. Change before
# production. Only applied when the postgres_data volume is first created.
# DATAVERSE_DB_USER=dataverse
# DATAVERSE_DB_PASSWORD=secret

# Browser CORS allow-origin. Default allows any origin.
# DATAVERSE_CORS_ORIGIN=*

# Fake DOI provider (authority/shoulder) passed as JVM args. Change before
# production if you need a different demo prefix.
# DATAVERSE_PID_FAKE_AUTHORITY=10.5072
# DATAVERSE_PID_FAKE_SHOULDER=FK2/


# Hosted ARP Schema Registry (CEDAR): https://cedar.schema.researchdata.hu
# ARP_CEDAR_DOMAIN=schema.researchdata.hu


# AROMA UI bundled in Dataverse at /aroma. 
# Override to point at a separate AROMA host if needed.
# ARP_AROMA_ADDRESS=http://localhost:8080/aroma


# Host IP if you access the stack from another machine. Defaults to localhost.
# MACHINE_IP=127.0.0.1


# Hosted CEDAR folder whose child folders contain templates to import as metadata blocks.
# Default is the Public ARP templates folder.
# CEDAR_IMPORT_FOLDER_ID=https://repo.schema.researchdata.hu/folders/49ba90b3-86ee-45b8-a623-d4a7a7df926c


# Dataverse collection that receives imported CEDAR templates (default: root).
# CEDAR_IMPORT_DV=root


# Optional. After startup, notify superusers (Notifications tab only) if this
# installation's DATAVERSE_SITEURL is not listed in the ARP federated search
# harvest registry (https://search.researchdata.hu/stats). Default false.
# ARP_HARVEST_REGISTRY_CHECK_ENABLED=true


# Import English/Hungarian UI translations from GitHub onto
# /dv/langBundles on Dataverse start. Default true.
# ARP_LANG_PACKS_UPDATE_ON_START=true
# ARP_LANG_PACKS_REPO_URL=https://github.com/dsd-sztaki-hu/dataverse-language-packs
# ARP_LANG_PACKS_REF=develop-hu-concorda-v6.9


# Hunverse is baked into the image. Uncomment BRANDING_DIR and the two branding
# volume lines in compose.yml to overlay local files.
# To overlay a custom folder (copy src/main/docker/branding, then edit):
# BRANDING_DIR=/path/to/custom/folder

# Navbar logo URL inside the container (arp-setup :LogoCustomizationFile).
# Change this if you replace topbanner_hunverse_002_dark425.png with another filename.
# LOGO_CUSTOMIZATION_FILE=/branding/your_top_banner.png


# Images. compose.yml defaults to Harbor (harbor.sztaki.hu/arp/...). Uncomment to override.
# DATAVERSE_IMAGE=harbor.sztaki.hu/arp/hunverse:6.9
# SOLR_UPDATER_IMAGE=harbor.sztaki.hu/arp/dataverse-solr-updater:6.9
# ROCRATE_PREVIEW_IMAGE=harbor.sztaki.hu/arp/dataverse-rocrate-preview:6.9


# Optional overrides (defaults match the hosted registry).
# ARP_W3ID_BASE=https://w3id.org/arp/dev
# TERMINOLOGY_URL_TEMPLATE=https://terminology.schema.researchdata.hu/bioportal/ontologies/%s/classes/%s/descendants?pageSize=500
# TERMINOLOGY_URL_BRANCHES=https://terminology.schema.researchdata.hu/bioportal/ontologies/%s/classes/%s/descendants?page=1&pageSize=500
# TERMINOLOGY_URL_VALUESETS=https://terminology.schema.researchdata.hu/bioportal/vs-collections/%s/value-sets/%s/values?page=1&pageSize=%s
# TERMINOLOGY_URL_ONTOLOGIES=https://terminology.schema.researchdata.hu/bioportal/ontologies/%s/classes?page=1&pageSize=500
